# Local development: omit DATABASE_URL to use SQLite, or set it explicitly.
# Production on Render: paste the Supabase Session Pooler connection string here.
DATABASE_URL=sqlite:///./career_agent.db

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=0

# Supabase persistence for Render Free (server-side only; never expose the service role key to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=career-files

# Shared Gemini fallback
GOOGLE_API_KEY=
DAYS_TO_SCAN=2
POLL_INTERVAL_SECONDS=120

# Render sets PORT automatically. Local Docker defaults to 8000.
PORT=8000
